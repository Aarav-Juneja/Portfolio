---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import DevFontHint from "~/components/DevFontHint.astro";
import { getImage } from "astro:assets";
import photo from "../assets/images/photo.jpeg";

const year = new Date().getFullYear();

interface Props {
    "navbar.shadow"?: true;
    title?: string;
    description?: string;
}

const props: Props = Astro.props;
const {
    title = "Aarav Juneja",
    description = "Aarav Juneja — high school cybersecurity researcher, DEF CON 34 speaker, and builder working on security, robotics, and applied AI.",
} = props;

const site = Astro.site ?? new URL("https://www.aaravjuneja.com");
const canonicalURL = new URL(Astro.url.pathname, site).href;
const ogImageAsset = await getImage({ src: photo, width: 1200, format: "jpg" });
const ogImageURL = new URL(ogImageAsset.src, site).href;

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Aarav Juneja",
    url: site.href,
    image: ogImageURL,
    sameAs: [
        "https://linkedin.com/in/aarav-juneja",
        "https://github.com/Aarav-Juneja",
    ],
    alumniOf: {
        "@type": "EducationalOrganization",
        name: "Amador Valley High School",
    },
    affiliation: {
        "@type": "EducationalOrganization",
        name: "Amador Valley High School",
    },
    knowsAbout: ["Cybersecurity", "Robotics", "Artificial Intelligence"],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="manifest" href="/app.webmanifest" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:site_name" content="Aarav Juneja" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
        <script is:inline>document.documentElement.classList.add("js");</script>
        <script is:inline>
            // Resolve theme: saved preference first, then OS preference.
            (function () {
                let saved = null;
                try { saved = localStorage.getItem('theme'); } catch (e) {}
                const theme = saved === 'light' || saved === 'dark'
                    ? saved
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.setAttribute('data-theme', theme);
            })();
        </script>
    </head>
    <body>
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:btn focus:btn-primary focus:btn-sm"
            >Skip to content</a
        >
        <div class="flex flex-col min-h-screen">
            <nav
                class={"navbar bg-base-300 fixed top-0 z-50 " +
                    (props?.["navbar.shadow"] && "shadow-md")}
            >
                <div class="flex-1 ml-3">
                    <a href="/" class="font-semibold text-lg">Aarav Juneja</a>
                </div>
                <a href="/reference" class="btn btn-ghost btn-sm font-mono text-xs opacity-70 hover:opacity-100">
                    <span class="dark-only">[REF]</span>
                    <span class="light-only font-medium">Reference</span>
                </a>
                {/* Blog hidden for now — restore this link to re-enable it.
                <a href="/blog" class="btn btn-ghost btn-sm font-mono text-xs opacity-70 hover:opacity-100">
                    <span class="dark-only">[BLOG]</span>
                    <span class="light-only font-medium">Blog</span>
                </a>
                */}
                <a href="/Aarav-Juneja-Resume.pdf" target="_blank" rel="noopener" class="btn btn-ghost btn-sm font-mono text-xs opacity-70 hover:opacity-100">
                    <span class="dark-only">[CV]</span>
                    <span class="light-only font-medium">Resume</span>
                </a>
                <DevFontHint />
                <label class="swap swap-rotate btn btn-ghost btn-circle">
                    <input type="checkbox" id="theme-toggle" aria-label="Toggle light/dark theme" />
                    <svg class="swap-off fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/></svg>
                    <svg class="swap-on fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/></svg>
                </label>
            </nav>
            <main id="main" tabindex="-1" class="flex-1">
                <slot />
            </main>
            <footer class="bg-base-300 p-5 flex flex-col items-center gap-2">
                <div class="flex flex-row gap-4">
                    <a
                        href="https://linkedin.com/in/aarav-juneja"
                        aria-label="LinkedIn"
                        ><Icon name="mdi:linkedin" size={30} />
                    </a>
                    <a
                        href="https://discord.com/users/1042177742331981945"
                        aria-label="Discord"
                        ><Icon name="ic:baseline-discord" size={30} />
                    </a>
                    <a
                        href="https://github.com/Aarav-Juneja"
                        aria-label="GitHub"
                        ><Icon name="mdi:github" size={30} />
                    </a>
                    <a
                        href="mailto:aarav@aaravjuneja.com"
                        aria-label="Email"
                        ><Icon name="mdi:email" size={30} />
                    </a>
                </div>
                <span class="dark-only font-mono text-xs opacity-50">j/k scroll | g top | G bottom</span>
                <span>© {year} Aarav Juneja.</span>
            </footer>
        </div>
        <script is:inline>
            (function () {
                function getSaved() {
                    try {
                        const v = localStorage.getItem('theme');
                        return v === 'light' || v === 'dark' ? v : null;
                    } catch (e) { return null; }
                }
                const mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: light)') : null;
                function resolve() {
                    return getSaved() || (mq && mq.matches ? 'light' : 'dark');
                }
                function apply(theme) {
                    document.documentElement.setAttribute('data-theme', theme);
                    const toggle = document.getElementById('theme-toggle');
                    if (toggle) toggle.checked = theme === 'light';
                }
                apply(resolve());

                const toggle = document.getElementById('theme-toggle');
                if (toggle) {
                    toggle.addEventListener('change', () => {
                        const newTheme = toggle.checked ? 'light' : 'dark';
                        apply(newTheme);
                        try { localStorage.setItem('theme', newTheme); } catch (e) {}
                    });
                }
                // Follow OS changes only while the user hasn't chosen a theme.
                if (mq && mq.addEventListener) {
                    mq.addEventListener('change', () => { if (!getSaved()) apply(resolve()); });
                }
            })();
        </script>
        <script is:inline>
            document.addEventListener('keydown', function(e) {
                const target = e.target;
                if (
                    !target ||
                    target.tagName === "INPUT" ||
                    target.tagName === "TEXTAREA"
                )
                    return;

                const scrollAmount = window.innerHeight * 0.7;

                switch (e.key) {
                    case "j":
                    case "ArrowDown":
                        window.scrollBy({ top: scrollAmount, behavior: "smooth" });
                        break;
                    case "k":
                    case "ArrowUp":
                        window.scrollBy({ top: -scrollAmount, behavior: "smooth" });
                        break;
                    case "G":
                        window.scrollTo({
                            top: document.body.scrollHeight,
                            behavior: "smooth",
                        });
                        break;
                    case "g":
                        if (!e.shiftKey) {
                            window.scrollTo({ top: 0, behavior: "smooth" });
                        }
                        break;
                }
            });
        </script>
        <script>
            import "~/scripts/motion";
        </script>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
