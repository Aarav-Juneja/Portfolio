---
import { awards } from "~/portfolio-data";

const { hiddenTitles = [] } = Astro.props;
const visibleAwards = awards.filter((award) => !hiddenTitles.includes(award.title));
---

<section id="awards" class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">
            <span class="border-b-4 border-accent pb-2">Awards & Achievements</span>
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
            {visibleAwards.map((award, index) => (
                <div class={`card bg-base-300 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 cursor-pointer group ${award.highlight ? 'ring-2 ring-primary' : ''}`}
                     style={`animation: fadeInUp 0.5s ease forwards ${index * 100}ms; opacity: 0;`}>
                    <div class="card-body">
                        <div class="flex justify-between items-start">
                            <h3 class="card-title text-base group-hover:text-primary transition-colors">{award.title}</h3>
                            <span class="badge badge-primary badge-sm">{award.year}</span>
                        </div>
                        <p class="text-base-content/70 text-sm mt-1">{award.description}</p>
                        {award.highlight && (
                            <div class="absolute -top-2 -right-2">
                                <span class="text-2xl">🏆</span>
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>
