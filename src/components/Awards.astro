---
import { awards, competitions } from "~/portfolio-data";
---

<section id="awards" class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">
            <span class="border-b-4 border-accent pb-2">Awards & Achievements</span>
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
            {awards.map((award, index) => (
                <div class={`card bg-base-300 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 cursor-pointer group ${award.highlight ? 'ring-2 ring-primary' : ''}`}
                     style={`animation: fadeInUp 0.5s ease forwards ${index * 100}ms; opacity: 0;`}>
                    <div class="card-body">
                        <div class="flex justify-between items-start">
                            <h3 class="card-title text-base group-hover:text-primary transition-colors">{award.title}</h3>
                            <span class="badge badge-primary badge-sm">{award.year}</span>
                        </div>
                        <p class="text-base-content/70 text-sm mt-1">{award.description}</p>
                        {award.highlight && (
                            <div class="absolute -top-2 -right-2">
                                <span class="text-2xl">🏆</span>
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-12">
            <h3 class="text-xl font-semibold mb-6 text-center">Competitions</h3>
            <div class="flex flex-wrap justify-center gap-4">
                {competitions.map((comp) => (
                    <div class="badge badge-lg badge-outline hover:badge-accent transition-colors p-4 font-mono">
                        <span class="font-semibold">{comp.name}</span>
                        {comp.years && (
                            <span class="ml-2 opacity-70">{comp.years.join(", ")}</span>
                        )}
                        {comp.year && (
                            <span class="ml-2 opacity-70">{comp.year}</span>
                        )}
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
