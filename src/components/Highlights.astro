---
import { additionalActivities, experience } from "~/portfolio-data";

const featuredExperience = experience.find((item) => item.highlight);
const featuredConference = additionalActivities.find(
    (item) => item.type === "conference" && item.highlight,
);
const featuredPublication = additionalActivities.find(
    (item) => item.type === "publication" && item.highlight,
);
const hasFeatured = Boolean(
    featuredExperience || featuredConference || featuredPublication,
);
---

{
    hasFeatured && (
        <section id="highlights" class="py-20 px-4 bg-base-200/40">
            <div class="max-w-5xl mx-auto">
                <div class="font-mono text-sm text-primary mb-4 opacity-80 dark-only text-center">
                    <span>&gt; ls ./featured</span>
                </div>
                <h2 class="text-3xl font-bold mb-10 text-center">
                    <span class="border-b-4 border-accent pb-2">Featured Highlights</span>
                </h2>
                <div class="grid md:grid-cols-2 gap-6">
                    {featuredConference && (
                        <article class="card bg-base-300 shadow-2xl ring-2 ring-accent">
                            <div class="card-body">
                                <div class="flex items-center justify-between gap-3 flex-wrap">
                                    <span class="badge badge-accent">
                                        <span class="dark-only font-mono">talk</span>
                                        <span class="light-only">Conference Talk</span>
                                    </span>
                                    <span class="badge badge-outline">{featuredConference.year}</span>
                                </div>
                                <h3 class="card-title text-xl mt-2">{featuredConference.title}</h3>
                                <p class="text-base-content/75">{featuredConference.description}</p>
                                {"videoId" in featuredConference && featuredConference.videoId && (
                                    <div class="mt-4 aspect-video w-full overflow-hidden rounded-lg bg-base-200">
                                        <iframe
                                            class="h-full w-full"
                                            src={`https://www.youtube-nocookie.com/embed/${featuredConference.videoId}`}
                                            title={`Talk recording: ${featuredConference.title}`}
                                            loading="lazy"
                                            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            referrerpolicy="strict-origin-when-cross-origin"
                                            allowfullscreen
                                        ></iframe>
                                    </div>
                                )}
                            </div>
                        </article>
                    )}
                    {featuredPublication && (
                        <article class="card bg-base-300 shadow-2xl ring-2 ring-primary">
                            <div class="card-body">
                                <div class="flex items-center justify-between gap-3 flex-wrap">
                                    <span class="badge badge-primary">
                                        <span class="dark-only font-mono">book</span>
                                        <span class="light-only">Forthcoming Book</span>
                                    </span>
                                    <span class="badge badge-outline">{featuredPublication.year}</span>
                                </div>
                                <h3 class="card-title text-xl mt-2">{featuredPublication.title}</h3>
                                <p class="text-base-content/75">{featuredPublication.description}</p>
                            </div>
                        </article>
                    )}
                    {featuredExperience && (
                        <article class="card bg-base-300 shadow-2xl ring-2 ring-primary md:col-span-2">
                            <div class="card-body">
                                <div class="flex items-center justify-between gap-3 flex-wrap">
                                    <span class="badge badge-primary">Featured</span>
                                    <span class="badge badge-outline">{featuredExperience.period}</span>
                                </div>
                                <h3 class="card-title text-xl mt-2">{featuredExperience.title}</h3>
                                <p class="text-accent font-medium text-sm">{featuredExperience.organization}</p>
                                <p class="text-base-content/75">{featuredExperience.description}</p>
                            </div>
                        </article>
                    )}
                </div>
            </div>
        </section>
    )
}
