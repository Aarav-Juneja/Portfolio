---
import { goals } from "~/portfolio-data";
---

<section id="goals" class="py-20 px-4 bg-base-200/30">
    <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">
            <span class="border-b-4 border-primary pb-2">Current Goals</span>
        </h2>
        
        <div class="grid md:grid-cols-3 gap-4">
            {goals.map((goal, index) => (
                <div class="card bg-base-300 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
                     style={`animation: fadeInUp 0.5s ease forwards ${index * 100}ms; opacity: 0;`}>
                    <div class="card-body items-center text-center">
                        <span class="text-4xl mb-2">{goal.icon}</span>
                        <h3 class="card-title text-base">{goal.title}</h3>
                        <p class="text-base-content/60 text-sm">{goal.description}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
