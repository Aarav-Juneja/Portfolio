---
// Full-width "story bands" (security / robotics) that
// replace the old Highlights card grid. Each band uses a different layout.
import { Image } from "astro:assets";
import { additionalActivities, experience } from "~/portfolio-data";
import SectionHeading from "./SectionHeading.astro";
import TalkTerminal from "./TalkTerminal.astro";
// Real photo of AVBotz's RoboSub 2026 vehicle, Marlin V3 ("Our AUV, Marlin V3
// on the road"), from the team's vehicle page: https://avbotz.com/marlin-v3
// (image: https://cdn.sanity.io/images/vi0qcj24/production/05c7c156d6d379d321ba1e4ecd9fdefdcc3d6aa6-678x447.webp).
// Vehicle name confirmed by the RS26 Technical Design Report:
// https://robonation.org/app/uploads/sites/4/2026/07/RS26_TDR_AmadorValleyHS_AVBotz.pdf
import marlinPhoto from "~/assets/images/robosub/marlin-v3.jpg";
import talkThumb from "~/assets/images/defcon-talk-thumb.jpg";

const talk = additionalActivities.find((a) => a.type === "conference" && a.highlight);
const talkVideoId = talk && "videoId" in talk ? talk.videoId : undefined;
const talkTitle =
    "Man-in-the-Browser: Hijacking JavaScript APIs for Browser Persistence and Credential Theft";

const robosub = experience.find((e) => e.highlight && /robosub/i.test(e.title));
const vehicle = robosub && "vehicle" in robosub ? robosub.vehicle : undefined;
const stack = ["Behavior trees", "ROS 2", "Zephyr RTOS", "Simulation"];
---

{
    talk && (
        <section id="security" class="py-24 md:py-32 px-4">
            <div class="max-w-6xl mx-auto">
                <SectionHeading
                    index="01"
                    eyebrow="Security"
                    title="Taking browser research to the DEF CON stage."
                    command="cat talks/defcon34"
                />
                <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
                    {talkVideoId && (
                        <div class="lg:col-span-7" data-reveal>
                            <div class="aspect-video w-full overflow-hidden rounded-2xl bg-base-300 shadow-2xl ring-1 ring-base-content/10">
                                {/* Click-to-load: YouTube's player (~1 MB of JS) only loads when someone presses play. */}
                                <a
                                    href={`https://www.youtube.com/watch?v=${talkVideoId}`}
                                    data-yt-facade={talkVideoId}
                                    data-yt-title={`DEF CON 34 talk recording: ${talkTitle}`}
                                    class="group relative block h-full w-full"
                                    aria-label={`Play DEF CON 34 talk recording: ${talkTitle}`}
                                >
                                    <Image
                                        src={talkThumb}
                                        alt=""
                                        widths={[480, 800, 1280]}
                                        sizes="(min-width: 1024px) 640px, 100vw"
                                        class="h-full w-full object-cover"
                                    />
                                    <span class="absolute inset-0 grid place-items-center bg-black/10 group-hover:bg-black/0 transition-colors">
                                        <span class="grid h-16 w-16 place-items-center rounded-full bg-black/70 text-white shadow-xl transition-transform group-hover:scale-110">
                                            <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                                        </span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    )}
                    <div class={talkVideoId ? "lg:col-span-5" : "lg:col-span-12"} data-reveal data-reveal-delay="150">
                        <div class="light-only">
                            <p class="text-sm font-medium text-base-content/60">
                                DEF CON 34 · AppSec Village · Las Vegas · August 2026
                            </p>
                            <h3 class="mt-4 text-2xl md:text-3xl font-semibold leading-snug">{talkTitle}</h3>
                            <p class="mt-5 text-base-content/70 leading-relaxed">
                                A talk on how malicious browser extensions can hijack JavaScript APIs to persist in
                                the browser and steal credentials.
                            </p>
                            {talk.link && (
                                <a
                                    href={talk.link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="mt-8 inline-flex items-center gap-2 font-medium text-primary hover:underline underline-offset-4"
                                >
                                    Watch on YouTube <span aria-hidden="true">→</span>
                                </a>
                            )}
                        </div>
                        <div class="dark-only">
                            <TalkTerminal />
                        </div>
                    </div>
                </div>
                <figure class="mt-14 md:mt-16 max-w-3xl border-l-2 border-primary pl-6" data-reveal>
                    <blockquote class="text-xl md:text-2xl leading-snug">
                        <p>
                            <span class="dark-only font-mono text-primary/70">&gt; </span>“We need more voices like his
                            contributing to this community.”
                        </p>
                    </blockquote>
                    <figcaption class="mt-3 text-sm text-base-content/60">
                        Keith Hoodlet,
                        <a
                            href="https://securing.dev/posts/defcon-villages-are-in-trouble/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-primary hover:underline underline-offset-4"
                            >“DEF CON villages are in trouble”</a
                        >{" "}<span class="light-only">· securing.dev</span><span class="dark-only font-mono">@ securing.dev</span>
                    </figcaption>
                </figure>
            </div>
        </section>
    )
}

{
    robosub && (
        <section id="robotics" class="py-24 md:py-32 px-4 bg-base-200/40">
            <div class="max-w-6xl mx-auto">
                <SectionHeading
                    index="02"
                    eyebrow="Robotics"
                    title="Teaching a submarine to think for itself."
                    command="ros2 launch marlin_v3"
                />
                <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
                    <div class="lg:col-span-5 order-2 lg:order-1" data-reveal data-reveal-delay="150">
                        <p class="text-sm font-medium text-base-content/60">
                            {robosub.organization} · RoboSub 2026
                            <a href="https://github.com/avbotz" target="_blank" rel="noopener noreferrer" class="dark-only ml-2 inline-block whitespace-nowrap font-mono text-primary hover:underline underline-offset-4">[github.com/avbotz]</a>
                        </p>
                        <h3 class="mt-4 text-2xl md:text-3xl font-semibold leading-snug">Autonomous Systems Lead</h3>
                        <dl class="mt-8 grid grid-cols-2 gap-6 border-y border-base-content/10 py-6">
                            <div>
                                <dt class="text-xs uppercase tracking-widest text-base-content/50">Field</dt>
                                <dd class="mt-1 text-3xl font-bold">
                                    <span data-countup="60">60</span>+
                                    <span class="text-base font-medium text-base-content/60">teams</span>
                                </dd>
                            </div>
                            <div>
                                <dt class="text-xs uppercase tracking-widest text-base-content/50">Result</dt>
                                <dd class="mt-1 text-3xl font-bold text-primary">Semifinalist</dd>
                            </div>
                        </dl>
                        <p class="mt-6 text-base-content/70 leading-relaxed">
                            Led autonomy for an underwater vehicle competing against collegiate teams including
                            Stanford, Cornell, and CMU, and finished ahead of UC Berkeley and UCLA.
                        </p>
                        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
                            {stack.map((s) => (
                                <li class="rounded-full border border-base-content/15 px-3 py-1 text-sm text-base-content/75">
                                    <span class="dark-only font-mono">{s.toLowerCase().replace(/ /g, "_")}</span>
                                    <span class="light-only">{s}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                    <figure class="lg:col-span-7 order-1 lg:order-2" data-reveal>
                        <div class="overflow-hidden rounded-2xl bg-base-300 shadow-2xl ring-1 ring-base-content/10">
                            <Image
                                src={marlinPhoto}
                                alt={`${vehicle ?? "AVBotz's autonomous underwater vehicle"}, the AVBotz RoboSub 2026 submarine, on pavement`}
                                widths={[480, 678]}
                                sizes="(min-width: 1024px) 58vw, 100vw"
                                class="w-full h-auto"
                            />
                        </div>
                        <figcaption class="mt-4 flex items-baseline justify-between gap-4 text-sm text-base-content/60">
                            <span>
                                <span class="font-semibold text-base-content">{vehicle ?? "AVBotz AUV"}</span>
                                <span class="dark-only font-mono"> // auv</span>
                                <span class="light-only"> · autonomous underwater vehicle</span>
                            </span>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </section>
    )
}


<script>
    document.querySelectorAll<HTMLAnchorElement>("[data-yt-facade]").forEach((a) => {
        a.addEventListener("click", (e) => {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // allow open-in-new-tab
            e.preventDefault();
            const iframe = document.createElement("iframe");
            iframe.src = `https://www.youtube-nocookie.com/embed/${a.dataset.ytFacade}?autoplay=1`;
            iframe.title = a.dataset.ytTitle ?? "Video";
            iframe.className = "h-full w-full";
            iframe.allow = "autoplay; accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            iframe.referrerPolicy = "strict-origin-when-cross-origin";
            iframe.allowFullscreen = true;
            a.replaceWith(iframe);
            iframe.focus();
        });
    });
</script>
