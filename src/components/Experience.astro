---
import { experience } from "~/portfolio-data";

const prioritizedExperience = [...experience].sort(
    (a, b) => Number(Boolean(b.highlight)) - Number(Boolean(a.highlight)),
);
---

<section id="experience" class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">
            <span class="border-b-4 border-primary pb-2">Experience</span>
        </h2>
        
        <div class="relative">
            <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-primary opacity-30"></div>
            
            <div class="space-y-12">
                {prioritizedExperience.map((exp, index) => (
                    <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                        <div class="md:w-1/2 pl-12 md:pl-0">
                            <div class={`card bg-base-200 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${index % 2 === 0 ? 'md:mr-8' : 'md:ml-8'} ${exp.highlight ? 'ring-2 ring-primary shadow-2xl' : ''}`}>
                                <div class="card-body">
                                    <div class="flex items-center gap-2 flex-wrap mb-2">
                                        <div class="badge badge-primary badge-outline">{exp.period}</div>
                                        {exp.highlight && <div class="badge badge-accent">Featured</div>}
                                    </div>
                                    <h3 class={`card-title ${exp.highlight ? 'text-xl' : 'text-lg'}`}>{exp.title}</h3>
                                    <p class="text-accent text-sm">{exp.organization}</p>
                                    <p class="text-base-content/70 text-sm mt-2">{exp.description}</p>
                                </div>
                            </div>
                        </div>
                        <div class="absolute left-4 md:left-1/2 transform -translate-x-1/2 mt-4">
                            <div class="w-4 h-4 rounded-full bg-primary ring-4 ring-base-100 animate-pulse"></div>
                        </div>
                    </div>
                ))}
            </div>
        </div>

    </div>
</section>
