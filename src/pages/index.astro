---
import Layout from "~/layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionNav from "~/components/SectionNav.astro";
import Stories from "~/components/Stories.astro";
import AwardsTimeline from "~/components/AwardsTimeline.astro";
import SkillsTicker from "~/components/SkillsTicker.astro";
import About from "~/components/About.astro";
import { resumeUrl, profile } from "~/portfolio-data";
import photo from "~/assets/images/photo.jpeg";

const iconLinks = [
    { href: "https://linkedin.com/in/aarav-juneja", label: "LinkedIn", icon: "mdi:linkedin", external: true, cls: "hide-in-dark" },
    { href: "https://discord.com/users/1042177742331981945", label: "Discord", icon: "ic:baseline-discord", external: true, cls: "hide-in-light" },
    { href: "https://github.com/Aarav-Juneja", label: "GitHub", icon: "mdi:github", external: true, cls: "" },
    { href: resumeUrl, label: "Resume (PDF)", icon: "mdi:file-document-outline", external: true, cls: "" },
    { href: "mailto:aarav@aaravjuneja.com", label: "Email", icon: "mdi:email-outline", external: false, cls: "" },
];
---

<Layout>
    <canvas
        id="matrix-rain"
        class="fixed inset-0 pointer-events-none opacity-10 z-0"></canvas>

    <section id="hero" class="relative z-10 min-h-[calc(100svh-44px)] flex items-center pt-24 pb-20 px-4">
        <div class="max-w-6xl w-full mx-auto flex flex-col-reverse md:flex-row md:items-center gap-10 md:gap-20">
            <div class="flex-1 space-y-6 hero-in">
                <p class="font-mono text-sm text-primary/80 dark-only">
                    <span class="animate-pulse">$</span> whoami
                </p>
                <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.02]">
                    Aarav Juneja<span class="text-primary dark-only animate-pulse">_</span><span class="text-primary light-only">.</span>
                </h1>
                <p class="text-lg md:text-2xl text-base-content/70 max-w-2xl leading-relaxed">
                    I break things to understand them, then build better ones,
                    across security, robotics, and applied&nbsp;AI.
                    <span class="block mt-3 text-base md:text-lg text-base-content/50">
                        <span class="dark-only font-mono">&gt; </span>Junior <span class="light-only">at</span><span class="dark-only">@</span> {profile.school}
                        <span class="mx-1 opacity-50">·</span>
                        <span class="text-base-content/80 font-semibold">ACT {profile.act.composite}</span>
                        <span class="whitespace-nowrap">(Math {profile.act.math} · Science {profile.act.science})</span>
                    </span>
                </p>
                <ul class="flex gap-2 pt-2" aria-label="Links">
                    {iconLinks.map((l) => (
                        <li class={l.cls}>
                            <a
                                href={l.href}
                                aria-label={l.label}
                                title={l.label}
                                {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                                class="btn btn-ghost btn-circle border border-base-content/15 hover:border-primary hover:text-primary"
                            >
                                <Icon name={l.icon} size={24} aria-hidden="true" />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="hero-in hero-in-delay shrink-0">
                <Image
                    src={photo}
                    alt="Aarav Juneja"
                    class="rounded-3xl w-40 h-40 md:w-64 md:h-64 lg:w-80 lg:h-80 object-cover ring-1 ring-base-content/10 shadow-xl"
                    width={320}
                    height={320}
                    densities={[1, 2]}
                    loading="eager"
                    fetchpriority="high"
                />
            </div>
        </div>
        <a href="#security" aria-label="Scroll to content" class="absolute bottom-6 left-1/2 -translate-x-1/2 opacity-40 hover:opacity-80 scroll-cue">
            <Icon name="mdi:chevron-down" size={28} aria-hidden="true" />
        </a>
    </section>

    <SectionNav />
    <Stories />
    <AwardsTimeline hiddenTitles={["Science Bowl - 3rd Place"]} />
    <SkillsTicker />
    <About />
</Layout>


<script>
    // Matrix rain (dark mode only). Kept cheap: drawn at half resolution and
    // CSS-scaled (it sits at 10% opacity, so the softness is invisible), capped
    // at ~20 fps via requestAnimationFrame, and fully stopped in light mode,
    // in background tabs, and for reduced-motion users.
    const canvas = document.getElementById("matrix-rain") as HTMLCanvasElement | null;
    const ctx = canvas?.getContext("2d", { alpha: true });
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!canvas || !ctx || reduceMotion) {
        canvas?.remove();
    } else {
        const SCALE = 0.5;
        const FONT = 14 * SCALE;
        const FRAME_MS = 50;
        let drops: number[] = [];
        let raf = 0;
        let last = 0;

        const isDark = () => document.documentElement.getAttribute("data-theme") !== "light";

        function resize() {
            canvas!.width = Math.ceil(window.innerWidth * SCALE);
            canvas!.height = Math.ceil(window.innerHeight * SCALE);
            canvas!.style.width = "100vw";
            canvas!.style.height = "100vh";
            const columns = Math.ceil(canvas!.width / FONT);
            const rows = canvas!.height / FONT;
            drops = Array.from({ length: columns }, (_, i) => drops[i] ?? Math.floor(Math.random() * rows));
            ctx!.font = `${FONT}px monospace`;
        }

        function draw() {
            ctx!.fillStyle = "rgba(0, 0, 0, 0.05)";
            ctx!.fillRect(0, 0, canvas!.width, canvas!.height);
            ctx!.fillStyle = "#22c55e";
            for (let i = 0; i < drops.length; i++) {
                ctx!.fillText(Math.random() < 0.5 ? "0" : "1", i * FONT, drops[i] * FONT);
                if (drops[i] * FONT > canvas!.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }
        }

        function loop(t: number) {
            raf = requestAnimationFrame(loop);
            if (t - last < FRAME_MS) return;
            last = t;
            draw();
        }

        function sync() {
            const run = isDark() && !document.hidden;
            canvas!.style.display = isDark() ? "block" : "none";
            if (run && !raf) raf = requestAnimationFrame(loop);
            if (!run && raf) {
                cancelAnimationFrame(raf);
                raf = 0;
            }
        }

        resize();
        sync();
        let resizeTimer = 0;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resize, 150);
        });
        document.addEventListener("visibilitychange", sync);
        new MutationObserver(sync).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme"],
        });
    }
</script>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-in {
        animation: fadeInUp 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero-in-delay {
        animation-delay: 0.15s;
    }
    .scroll-cue {
        animation: cueBob 2.4s ease-in-out infinite;
    }
    @keyframes cueBob {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, 6px); }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.6s ease forwards;
    }

    #matrix-canvas {
        animation: fadeIn 1s ease;
    }

    @media (prefers-reduced-motion: reduce) {
        #hero [style*="fadeInUp"],
        #hero [style*="animation"],
        section [style*="fadeInUp"] {
            animation: none !important;
            opacity: 1 !important;
        }

        .hero-in,
        .scroll-cue,
        .animate-spin,
        .animate-bounce,
        .animate-pulse {
            animation: none !important;
        }
    }
</style>
