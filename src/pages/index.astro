    <section id="about" class="py-20 px-4 bg-base-200/30 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
            <div class="font-mono text-sm text-primary mb-4 opacity-80 dark-only">
                <span>> cat about.txt</span>
            </div>
            <div class="text-sm text-primary/80 mb-4 light-only font-semibold tracking-[0.18em] uppercase">
                About
            </div>
            <h2 class="text-3xl font-bold mb-8">
                <span class="border-b-4 border-primary pb-2">About Me</span>
            </h2>
            <div class="prose prose-lg mx-auto">
                <p class="text-lg leading-relaxed font-mono dark-only">
                    <span class="text-primary">const</span> passion = [<span
                        class="text-accent">"cybersecurity"</span
                    >, <span class="text-accent">"building things"</span>];
                </p>
                <p class="text-lg leading-relaxed mt-4">
                    I'm a <span class="text-primary font-semibold"
                        >junior</span
                    > at Amador Valley High School with a deep passion for
                    <span class="text-accent font-semibold">cybersecurity</span> and
                    <span class="text-primary font-semibold"
                        >building things</span
                    >. I love tackling complex challenges - whether it's
                    breaking (and securing) code or building apps that people
                    actually use.
                </p>
                <p class="text-lg leading-relaxed mt-4">
                    When I'm not coding, you'll find me playing in chess,
                    tinkering with new technologies, or exploring the latest in
                    security research.
                </p>
            </div>

            <div class="flex flex-wrap justify-center gap-4 mt-8">
                <div
                    class="card bg-base-300 hover:bg-base-100 transition-colors cursor-pointer hover:scale-105 transform"
                >
                    <div class="card-body p-4 items-center text-center">
                        <span class="text-3xl">♟️</span>
                        <span class="text-sm font-medium">Chess</span>
                    </div>
                </div>
                <div
                    class="card bg-base-300 hover:bg-base-100 transition-colors cursor-pointer hover:scale-105 transform"
                >
                    <div class="card-body p-4 items-center text-center">
                        <span class="text-3xl">🔐</span>
                        <span class="text-sm font-medium">Cybersecurity</span>
                    </div>
                </div>
                <div
                    class="card bg-base-300 hover:bg-base-100 transition-colors cursor-pointer hover:scale-105 transform"
                >
                    <div class="card-body p-4 items-center text-center">
                        <span class="text-3xl">💻</span>
                        <span class="text-sm font-medium">Coding</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <Highlights />

    <div class="dark-only">
        <Awards hiddenTitles={["Science Bowl - 3rd Place"]} />
    </div>
    <div class="light-only">
        <Awards hiddenTitles={["Science Bowl - 3rd Place"]} />
    </div>
    <Skills />
    <Goals />
</Layout>

<script>
    const canvas = document.getElementById("matrix-rain") as HTMLCanvasElement;
    const ctx = canvas?.getContext("2d");

    function isLightTheme() {
        return document.documentElement.getAttribute("data-theme") === "light";
    }

    function updateMatrixVisibility() {
        if (!canvas) return;
        canvas.style.display = isLightTheme() ? "none" : "block";
    }

    updateMatrixVisibility();
    const themeObserver = new MutationObserver(updateMatrixVisibility);
    themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
    });

    if (!canvas || !ctx) {
        document.documentElement.classList.add("no-matrix");
    } else {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const chars = "01";
        const fontSize = 14;
        const columns = canvas.width / fontSize;

        const drops: number[] = [];
        for (let i = 0; i < columns; i++) {
            drops[i] = Math.floor(Math.random() * (canvas.height / fontSize));
        }

        function drawMatrix() {
            if (isLightTheme()) return;

            ctx!.fillStyle = "rgba(0, 0, 0, 0.05)";
            ctx!.fillRect(0, 0, canvas.width, canvas.height);

            ctx!.fillStyle = "#22c55e";
            ctx!.font = fontSize + "px monospace";

            for (let i = 0; i < drops.length; i++) {
                const char = chars[Math.floor(Math.random() * chars.length)];
                ctx!.fillText(char, i * fontSize, drops[i] * fontSize);

                if (
                    drops[i] * fontSize > canvas.height &&
                    Math.random() > 0.975
                ) {
                    drops[i] = 0;
                }
                drops[i]++;
            }
        }

        setInterval(drawMatrix, 50);

        window.addEventListener("resize", () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    }

</script>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.6s ease forwards;
    }

    #matrix-canvas {
        animation: fadeIn 1s ease;
    }
</style>
