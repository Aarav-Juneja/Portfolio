---
import Layout from "~/layouts/Layout.astro";
import { Image } from "astro:assets";
import Skills from "~/components/Skills.astro";
import Awards from "~/components/Awards.astro";
import Goals from "~/components/Goals.astro";
import Highlights from "~/components/Highlights.astro";
import { profile } from "~/portfolio-data";
import photo from "~/assets/images/photo.jpeg";
---

<Layout>
    <canvas
        id="matrix-rain"
        class="fixed inset-0 pointer-events-none opacity-10 z-0"></canvas>

    <section
        id="hero"
        class="min-h-screen flex items-center justify-center pt-16 relative"
    >


        <div
            class="relative z-10 flex flex-col md:flex-row items-center gap-12 px-4 max-w-6xl"
        >
            <div
                class="relative group"
                style="animation: fadeInUp 0.8s ease forwards;"
            >
                <div
                    class="absolute inset-0 rounded-full border-2 border-dashed border-primary opacity-30 animate-spin"
                    style="animation-duration: 10s;"
                >
                </div>
                <Image
                    src={photo}
                    alt="Aarav J."
                    class="relative rounded-full w-48 h-48 md:w-64 md:h-64 object-cover ring-4 ring-base-300 shadow-2xl"
                    width={256}
                    height={256}
                    loading="eager"
                    fetchpriority="high"
                />
            </div>

            <div
                class="text-center md:text-left space-y-4"
                style="animation: fadeInUp 0.8s ease 0.2s forwards; opacity: 0;"
            >
                <div class="font-mono text-sm text-primary opacity-80 dark-only">
                    <span class="animate-pulse">$</span> whoami
                </div>
                <div class="text-sm text-primary/80 light-only font-semibold tracking-[0.18em] uppercase">
                    Student • Builder • Security Enthusiast
                </div>
                <h1
                    class="text-4xl md:text-6xl font-bold text-primary font-mono"
                >
                    Aarav Juneja<span class="animate-pulse dark-only">_</span>
                </h1>
                <p class="text-xl md:text-2xl text-base-content/80 font-medium">
                    High School Student @ Amador Valley High
                </p>
                <p class="text-lg text-base-content/60">
                    <span class="dark-only font-mono">&gt; </span>GPA {profile.gpa} • SAT {profile.sat} • Class of {profile.graduation}
                </p>

                <div
                    class="flex flex-wrap justify-center md:justify-start gap-2 mt-4"
                >
                    <span class="badge badge-primary badge-lg font-mono"
                        >Cybersecurity</span
                    >
                    <span class="badge badge-accent badge-lg font-mono"
                        >Full-Stack Dev</span
                    >
                </div>

                <div class="flex justify-center md:justify-start gap-4 mt-6">
                    <a
                        href="https://linkedin.com/in/aarav-juneja"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary btn-circle hover:scale-110 transition-transform hide-in-dark"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
