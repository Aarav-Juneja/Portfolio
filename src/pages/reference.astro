---
import Layout from "~/layouts/Layout.astro";
import DevText from "~/components/DevText.astro";
import {
    profile,
    experience,
    clubPositions,
    awards,
    competitiveProgramming,
    competitions,
    skillCategories,
    goals,
    outsideCoursework,
    coursework,
    additionalActivities,
    externalLinks,
    resumeUrl,
    clistUrl,
    volunteering,
} from "~/portfolio-data";

const activityTypeLabels: Record<string, { dark: string; light: string }> = {
    publication: { dark: "[PUBLICATIONS]", light: "Publications" },
    conference: { dark: "[CONFERENCES & TALKS]", light: "Conferences & Talks" },
    certificate: { dark: "[CERTIFICATES]", light: "Certificates" },
};
const bugBounties = additionalActivities.filter((a) => a.type === "bugbounty");
// Every non-bug-bounty activity type gets its own labeled table, so new types are never dropped.
const activityTypeOrder = ["publication", "conference", "certificate"];
const activityTypes = [
    ...new Set(
        additionalActivities
            .map((a) => a.type)
            .filter((t) => t !== "bugbounty"),
    ),
].sort(
    (a, b) =>
        (activityTypeOrder.indexOf(a) + 1 || 99) -
        (activityTypeOrder.indexOf(b) + 1 || 99),
);
// Recency: newest first everywhere. Uses the latest 4-digit year in any of the
// given strings ("Present" counts as ongoing); grade levels ("6th Grade") sort
// by grade number below any calendar year. Featured items win ties.
const recency = (...fields: (string | string[] | undefined)[]) => {
    const text = fields.flat().filter(Boolean).join(" ");
    if (/present/i.test(text)) return 9999;
    const years = text.match(/\b(19|20)\d{2}\b/g)?.map(Number) ?? [];
    if (years.length) return Math.max(...years);
    const grade = text.match(/(\d+)(st|nd|rd|th)\s*grade/i);
    return grade ? Number(grade[1]) : 0;
};
const byRecency = <T extends { sortKey: number; featured?: boolean }>(a: T, b: T) =>
    b.sortKey - a.sortKey || Number(Boolean(b.featured)) - Number(Boolean(a.featured));

const toTitleCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const skillBadgeClasses = [
    "badge-outline",
    "badge-primary badge-outline",
    "badge-secondary badge-outline",
    "badge-accent badge-outline",
];
const rolePriority: Record<string, number> = {
    President: 1,
    "Vice President": 2,
    Treasurer: 3,
    "Activities Manager": 4,
    Secretary: 5,
};
const organizationPriority: Record<string, number> = {
    "Cybersecurity Club": 1,
    "Space & Astronomy Club": 2,
    "Chess Club": 3,
    "Anatomy Club": 4,
};
const getStartYear = (period?: string) =>
    Number.parseInt(period?.split("-")[0] || "0", 10);
const sortedClubPositions = [...clubPositions].sort((a, b) => {
    const yearDiff = getStartYear(b.period) - getStartYear(a.period);
    if (yearDiff !== 0) return yearDiff;

    const orgDiff =
        (organizationPriority[a.organization] ?? 99) -
        (organizationPriority[b.organization] ?? 99);
    if (orgDiff !== 0) return orgDiff;

    const roleDiff =
        (rolePriority[a.title] ?? 99) - (rolePriority[b.title] ?? 99);
    if (roleDiff !== 0) return roleDiff;

    return a.title.localeCompare(b.title);
});
const groupedClubPositions = sortedClubPositions.reduce(
    (acc, position) => {
        const year = position.period || "Other";
        if (!acc[year]) acc[year] = [];
        acc[year].push(position);
        return acc;
    },
    {} as Record<string, typeof clubPositions>,
);
const orderedClubPositionYears = Object.keys(groupedClubPositions).sort(
    (a, b) => getStartYear(b) - getStartYear(a),
);

const data = {
    education: profile,
    // Current-year classes first, then the rest; no year headings.
    coursework: [...coursework].sort((a, b) => recency(b.year) - recency(a.year)),
    experience: experience
        .map((e) => ({
            title: e.title,
            org: e.organization,
            period: e.period,
            details:
                "vehicle" in e && e.vehicle
                    ? `${e.description} Vehicle: ${e.vehicle}.`
                    : e.description,
            featured: Boolean(e.highlight),
            sortKey: recency(e.period),
        }))
        .sort(byRecency),
    clubPositionsByYear: orderedClubPositionYears.map((year) => ({
        year,
        items: groupedClubPositions[year],
    })),
    awards: awards
        .map((a) => ({
            title: a.title,
            year: a.year,
            details: a.description,
            featured: Boolean(a.highlight),
            sortKey: recency(a.year),
        }))
        .sort(byRecency),
    competitiveProgramming: competitiveProgramming.map((cp) => ({
        platform: cp.platform,
        rating: cp.rating,
        rank: cp.rank,
        detail: cp.detail,
    })),
    competitions: competitions
        .map((c) => ({
            name: c.name,
            full: c.fullName,
            year: c.years ? c.years.join(", ") : c.year || "",
            sortKey: recency(c.years, c.year),
        }))
        .sort(byRecency),
    skills: skillCategories.map((c, i) => ({
        name: c.name,
        skills: c.skills,
        badgeClass: skillBadgeClasses[i % skillBadgeClasses.length],
    })),
    goals: goals.map((g) => g.title),
    outsideCoursework: outsideCoursework
        .map((c) => ({
            name: c.name,
            issuer: c.issuer,
            year: c.year,
            link: c.link,
            sortKey: recency(c.year),
        }))
        .sort(byRecency),
    activityGroups: activityTypes.map((type) => ({
        type,
        label: activityTypeLabels[type] ?? {
            dark: `[${type.toUpperCase()}]`,
            light: toTitleCase(type),
        },
        items: additionalActivities
            .filter((a) => a.type === type)
            .map((a) => ({
                title: a.title,
                year: a.year,
                details: a.description,
                link: a.link || null,
                linkLabel: "videoId" in a && a.videoId ? "Watch" : "View",
                featured: Boolean(a.highlight),
                sortKey: recency(a.year),
            }))
            .sort(byRecency),
    })),
    bugBounties: bugBounties
        .map((b) => ({ title: b.title, year: b.year, sortKey: recency(b.year) }))
        .sort(byRecency),
    volunteering: volunteering
        .map((v) => ({
            title: v.title,
            year: "years" in v && v.years ? v.years.join(", ") : v.year,
            sortKey: recency("years" in v ? v.years : undefined, v.year),
        }))
        .sort(byRecency),
    links: externalLinks.map((l) => ({ name: l.name, url: l.url })),
};
---

<Layout
    title="Reference — Aarav Juneja"
    description="Full record of Aarav Juneja's awards, competitions, coursework, and activities."
>
    <div class="pt-24 pb-12 px-4 max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-primary font-mono mb-2">
            <span class="dark-only"><span class="animate-pulse">></span> ./reference.sh</span>
            <span class="light-only font-sans">Reference</span>
        </h1>
        <p class="text-base-content/60 text-sm mb-8">
            <span class="dark-only font-mono">Quick lookup for all portfolio data</span>
            <span class="light-only">A quick reference for portfolio details and highlights.</span>
        </p>
        <a href={resumeUrl} target="_blank" rel="noopener" class="btn btn-primary btn-sm mb-8 -mt-4">
            <span class="dark-only font-mono">$ open resume.pdf</span>
            <span class="light-only">Download resume (PDF)</span>
        </a>

        <div class="space-y-8">
            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[EDUCATION]</span>
                        <span class="light-only">Education</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <tbody>
                                <tr
                                    ><td class="font-bold">School</td><td
                                        >{data.education.school}</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">Graduation</td><td
                                        >Class of {
                                            data.education.graduation
                                        }</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">GPA</td><td
                                        >{data.education.gpa}</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">ACT</td><td
                                        ><span class="font-bold">{data.education.act.composite}</span>
                                        <span class="opacity-70">
                                            (English {data.education.act.english} · Reading {data.education.act.reading} · Math {data.education.act.math} · Science {data.education.act.science})
                                        </span></td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">SAT</td><td
                                        >{data.education.sat}</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">Coursework</td><td
                                        >{
                                            data.coursework
                                                .map((c) =>
                                                    c.description
                                                        ? `${c.name} (${c.description.replace(/\.$/, "")})`
                                                        : c.name,
                                                )
                                                .join(", ")
                                        }</td
                                    ></tr
                                >
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[EXPERIENCE]</span>
                        <span class="light-only">Experience</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Title</th><th>Org</th><th>Period</th
                                    ><th>Details</th></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.experience.map((exp) => (
                                        <tr class={exp.featured ? "bg-primary/10" : ""}>
                                            <td class="font-bold">
                                                {exp.title}
                                                {exp.featured && (
                                                    <span class="badge badge-accent badge-xs ml-2">Featured</span>
                                                )}
                                            </td>
                                            <td>{exp.org}</td>
                                            <td>{exp.period}</td>
                                            <td><DevText text={exp.details} /></td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="divider text-xs opacity-50">
                        <span class="dark-only font-mono">Other Positions</span>
                        <span class="light-only">Other Positions</span>
                    </div>
                    <div class="space-y-3">
                        {
                            data.clubPositionsByYear.map((group) => (
                                <div>
                                    <p class="text-xs font-bold opacity-60 mb-2">
                                        {group.year}
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        {group.items.map((pos) => (
                                            <span class="badge badge-outline">
                                                {pos.title} | {pos.organization}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[AWARDS]</span>
                        <span class="light-only">Awards</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Award</th><th>Year</th><th>Details</th
                                    ></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.awards.map((award) => (
                                        <tr class={award.featured ? "bg-primary/10" : ""}>
                                            <td class="font-bold">
                                                {award.title}
                                                {award.featured && (
                                                    <span class="badge badge-accent badge-xs ml-2">Featured</span>
                                                )}
                                            </td>
                                            <td>{award.year}</td>
                                            <td><DevText text={award.details} /></td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[COMPETITIVE PROGRAMMING]</span>
                        <span class="light-only">Competitive Programming</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Platform</th><th>Rating</th><th
                                        >Rank</th
                                    ><th>Details</th></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.competitiveProgramming.map((cp) => (
                                        <tr>
                                            <td class="font-bold">
                                                {cp.platform}
                                            </td>
                                            <td>{cp.rating}</td>
                                            <td>{cp.rank}</td>
                                            <td>{cp.detail}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                    <a href={clistUrl} target="_blank" rel="noopener noreferrer" class="link link-primary text-sm mt-2 self-start">
                        <span class="dark-only font-mono">$ open clist.by/coder/AaravJ</span>
                        <span class="light-only">All contest ratings on clist.by ↗</span>
                    </a>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[COMPETITIONS]</span>
                        <span class="light-only">Competitions</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Short</th><th>Full Name</th><th
                                        >Year(s)</th
                                    ></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.competitions.map((comp) => (
                                        <tr>
                                            <td class="font-bold">
                                                {comp.name}
                                            </td>
                                            <td>{comp.full || comp.name}</td>
                                            <td>{comp.year}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[SKILLS]</span>
                        <span class="light-only">Skills</span>
                    </h2>
                    <div class="space-y-3">
                        {
                            data.skills.map((category) => (
                                <div>
                                    <span class="text-xs opacity-70">
                                        <span class="dark-only font-mono">{category.name}:</span>
                                        <span class="light-only">{category.name}:</span>
                                    </span>
                                    <div class="flex flex-wrap gap-1 mt-1">
                                        {category.skills.map((skill) => (
                                            <span class={`badge badge-sm ${category.badgeClass}`}>
                                                {skill}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[OUTSIDE COURSEWORK]</span>
                        <span class="light-only">Outside Coursework</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Course</th><th>Issuer</th><th>Year</th
                                    ><th>Certificate</th></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.outsideCoursework.map((course) => (
                                        <tr>
                                            <td class="font-bold">
                                                {course.name}
                                            </td>
                                            <td>{course.issuer}</td>
                                            <td>{course.year}</td>
                                            <td>
                                                {course.link ? (
                                                    <a
                                                        href={course.link}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="btn btn-xs btn-primary"
                                                    >
                                                        View
                                                    </a>
                                                ) : (
                                                    <span class="badge badge-ghost">
                                                        -
                                                    </span>
                                                )}
                                            </td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[BUG BOUNTIES]</span>
                        <span class="light-only">Bug Bounties</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr><th>Website</th><th>Year</th></tr>
                            </thead>
                            <tbody>
                                {
                                    data.bugBounties.map((bounty) => (
                                        <tr>
                                            <td class="font-bold">
                                                {bounty.title}
                                            </td>
                                            <td>{bounty.year}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            {
                data.activityGroups.map((group) => (
                    <section class="card bg-base-200">
                        <div class="card-body">
                            <h2 class="card-title text-primary">
                                <span class="dark-only font-mono">{group.label.dark}</span>
                                <span class="light-only">{group.label.light}</span>
                            </h2>
                            <div class="overflow-x-auto">
                                <table class="table table-zebra font-mono text-sm">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Year</th>
                                            <th>Details</th>
                                            <th>Link</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {group.items.map((item) => (
                                            <tr class={item.featured ? "bg-accent/10" : ""}>
                                                <td class="font-bold">
                                                    {item.title}
                                                    {item.featured && (
                                                        <span class="badge badge-accent badge-xs ml-2">Featured</span>
                                                    )}
                                                </td>
                                                <td>{item.year}</td>
                                                <td><DevText text={item.details} /></td>
                                                <td>
                                                    {item.link ? (
                                                        <a
                                                            href={item.link}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="btn btn-xs btn-primary"
                                                        >
                                                            {item.linkLabel}
                                                        </a>
                                                    ) : (
                                                        <span class="badge badge-ghost">-</span>
                                                    )}
                                                </td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                ))
            }

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[VOLUNTEERING]</span>
                        <span class="light-only">Volunteering</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr><th>Activity</th><th>Year</th></tr>
                            </thead>
                            <tbody>
                                {
                                    data.volunteering.map((vol) => (
                                        <tr>
                                            <td class="font-bold">
                                                {vol.title}
                                            </td>
                                            <td>{vol.year}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[GOALS]</span>
                        <span class="light-only">Goals</span>
                    </h2>
                    <ul class="list-disc list-inside">
                        {data.goals.map((goal) => <li>{goal}</li>)}
                    </ul>
                </div>
            </section>
        </div>
    </div>
</Layout>
