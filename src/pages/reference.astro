---
import Layout from "~/layouts/Layout.astro";
import {
    profile,
    experience,
    clubPositions,
    awards,
    competitions,
    skillCategories,
    goals,
    outsideCoursework,
    coursework,
    additionalActivities,
    externalLinks,
    volunteering,
} from "~/portfolio-data";

const bugBounties = additionalActivities.filter((a) => a.type === "bugbounty");
const conferences = additionalActivities.filter((a) => a.type === "conference");
const rolePriority: Record<string, number> = {
    President: 1,
    "Vice President": 2,
    Treasurer: 3,
    "Activities Manager": 4,
    Secretary: 5,
};
const organizationPriority: Record<string, number> = {
    "Cybersecurity Club": 1,
    "Space & Astronomy Club": 2,
    "Chess Club": 3,
    "Anatomy Club": 4,
};
const getStartYear = (period?: string) =>
    Number.parseInt(period?.split("-")[0] || "0", 10);
const sortedClubPositions = [...clubPositions].sort((a, b) => {
    const yearDiff = getStartYear(b.period) - getStartYear(a.period);
    if (yearDiff !== 0) return yearDiff;

    const orgDiff =
        (organizationPriority[a.organization] ?? 99) -
        (organizationPriority[b.organization] ?? 99);
    if (orgDiff !== 0) return orgDiff;

    const roleDiff =
        (rolePriority[a.title] ?? 99) - (rolePriority[b.title] ?? 99);
    if (roleDiff !== 0) return roleDiff;

    return a.title.localeCompare(b.title);
});
const groupedClubPositions = sortedClubPositions.reduce(
    (acc, position) => {
        const year = position.period || "Other";
        if (!acc[year]) acc[year] = [];
        acc[year].push(position);
        return acc;
    },
    {} as Record<string, typeof clubPositions>,
);
const orderedClubPositionYears = Object.keys(groupedClubPositions).sort(
    (a, b) => getStartYear(b) - getStartYear(a),
);

const data = {
    education: profile,
    coursework,
    experience: experience
        .map((e) => ({
            title: e.title,
            org: e.organization,
            period: e.period,
            details: e.description,
            featured: Boolean(e.highlight),
        }))
        .sort((a, b) => Number(b.featured) - Number(a.featured)),
    clubPositionsByYear: orderedClubPositionYears.map((year) => ({
        year,
        items: groupedClubPositions[year],
    })),
    awards: awards.map((a) => ({
        title: a.title,
        year: a.year,
        details: a.description,
    })),
    competitions: competitions.map((c) => ({
        name: c.name,
        full: c.fullName,
        year: c.years ? c.years.join(", ") : c.year || "",
    })),
    skills: {
        languages:
            skillCategories.find((c) => c.name === "Programming Languages")
                ?.skills || [],
        cybersecurity:
            skillCategories.find((c) => c.name === "Cybersecurity")?.skills ||
            [],
        tools:
            skillCategories.find((c) => c.name === "Tools & Technologies")
                ?.skills || [],
    },
    goals: goals.map((g) => g.title),
    outsideCoursework: outsideCoursework.map((c) => ({
        name: c.name,
        issuer: c.issuer,
        year: c.year,
        link: c.link,
    })),
    additional: additionalActivities.map((a) => ({
        title: a.title,
        year: a.year,
        details: a.description,
        link: a.link || null,
    })),
    bugBounties: bugBounties.map((b) => ({
        title: b.title,
        year: b.year,
    })),
    conferences: conferences
        .map((c) => ({
            title: c.title,
            year: c.year,
            details: c.description,
            link: c.link || null,
            featured: Boolean(c.highlight),
        }))
        .sort((a, b) => Number(b.featured) - Number(a.featured)),
    volunteering: volunteering.map((v) => ({
        title: v.title,
        year: v.year,
    })),
    links: externalLinks.map((l) => ({ name: l.name, url: l.url })),
};
---

<Layout>
    <div class="pt-24 pb-12 px-4 max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-primary font-mono mb-2">
            <span class="dark-only"><span class="animate-pulse">></span> ./reference.sh</span>
            <span class="light-only font-sans">Reference</span>
        </h1>
        <p class="text-base-content/60 text-sm mb-8">
            <span class="dark-only font-mono">Quick lookup for all portfolio data</span>
            <span class="light-only">A quick reference for portfolio details and highlights.</span>
        </p>

        <div class="space-y-8">
            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[EDUCATION]</span>
                        <span class="light-only">Education</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <tbody>
                                <tr
                                    ><td class="font-bold">School</td><td
                                        >{data.education.school}</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">Graduation</td><td
                                        >Class of {
                                            data.education.graduation
                                        }</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">GPA</td><td
                                        >{data.education.gpa}</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">SAT</td><td
                                        >{data.education.sat}</td
                                    ></tr
                                >
                                <tr
                                    ><td class="font-bold">Coursework</td><td
                                        >{
                                            data.coursework
                                                .map((c) =>
                                                    c.description
                                                        ? `${c.name} (${c.description})`
                                                        : c.name,
                                                )
                                                .join(", ")
                                        }</td
                                    ></tr
                                >
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[EXPERIENCE]</span>
                        <span class="light-only">Experience</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Title</th><th>Org</th><th>Period</th
                                    ><th>Details</th></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.experience.map((exp) => (
                                        <tr class={exp.featured ? "bg-primary/10" : ""}>
                                            <td class="font-bold">
                                                {exp.title}
                                                {exp.featured && (
                                                    <span class="badge badge-accent badge-xs ml-2">Featured</span>
                                                )}
                                            </td>
                                            <td>{exp.org}</td>
                                            <td>{exp.period}</td>
                                            <td>{exp.details}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="divider text-xs opacity-50">
                        <span class="dark-only font-mono">Other Positions</span>
                        <span class="light-only">Other Positions</span>
                    </div>
                    <div class="space-y-3">
                        {
                            data.clubPositionsByYear.map((group) => (
                                <div>
                                    <p class="text-xs font-bold opacity-60 mb-2">
                                        {group.year}
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        {group.items.map((pos) => (
                                            <span class="badge badge-outline">
                                                {pos.title} | {pos.organization}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[AWARDS]</span>
                        <span class="light-only">Awards</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Award</th><th>Year</th><th>Details</th
                                    ></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.awards.map((award) => (
                                        <tr>
                                            <td class="font-bold">
                                                {award.title}
                                            </td>
                                            <td>{award.year}</td>
                                            <td>{award.details}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[COMPETITIONS]</span>
                        <span class="light-only">Competitions</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Short</th><th>Full Name</th><th
                                        >Year(s)</th
                                    ></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.competitions.map((comp) => (
                                        <tr>
                                            <td class="font-bold">
                                                {comp.name}
                                            </td>
                                            <td>{comp.full || comp.name}</td>
                                            <td>{comp.year}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[SKILLS]</span>
                        <span class="light-only">Skills</span>
                    </h2>
                    <div class="space-y-3">
                        <div>
                            <span class="text-xs opacity-70">
                                <span class="dark-only font-mono">Languages:</span>
                                <span class="light-only">Languages:</span>
                            </span>
                            <div class="flex flex-wrap gap-1 mt-1">
                                {
                                    data.skills.languages.map((skill) => (
                                        <span class="badge badge-sm badge-outline">
                                            {skill}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                        <div>
                            <span class="text-xs opacity-70">
                                <span class="dark-only font-mono">Cybersecurity:</span>
                                <span class="light-only">Cybersecurity:</span>
                            </span>
                            <div class="flex flex-wrap gap-1 mt-1">
                                {
                                    data.skills.cybersecurity.map((skill) => (
                                        <span class="badge badge-sm badge-primary badge-outline">
                                            {skill}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                        <div>
                            <span class="text-xs opacity-70">
                                <span class="dark-only font-mono">Tools:</span>
                                <span class="light-only">Tools:</span>
                            </span>
                            <div class="flex flex-wrap gap-1 mt-1">
                                {
                                    data.skills.tools.map((skill) => (
                                        <span class="badge badge-sm badge-accent badge-outline">
                                            {skill}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[OUTSIDE COURSEWORK]</span>
                        <span class="light-only">Outside Coursework</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Course</th><th>Issuer</th><th>Year</th
                                    ><th>Certificate</th></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.outsideCoursework.map((course) => (
                                        <tr>
                                            <td class="font-bold">
                                                {course.name}
                                            </td>
                                            <td>{course.issuer}</td>
                                            <td>{course.year}</td>
                                            <td>
                                                {course.link ? (
                                                    <a
                                                        href={course.link}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="btn btn-xs btn-primary"
                                                    >
                                                        View
                                                    </a>
                                                ) : (
                                                    <span class="badge badge-ghost">
                                                        -
                                                    </span>
                                                )}
                                            </td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[BUG BOUNTIES]</span>
                        <span class="light-only">Bug Bounties</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr><th>Website</th><th>Year</th></tr>
                            </thead>
                            <tbody>
                                {
                                    data.bugBounties.map((bounty) => (
                                        <tr>
                                            <td class="font-bold">
                                                {bounty.title}
                                            </td>
                                            <td>{bounty.year}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[ADDITIONAL ACTIVITIES]</span>
                        <span class="light-only">Additional Activities</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr
                                    ><th>Activity</th><th>Year</th><th
                                        >Details</th
                                    ><th>Link</th></tr
                                >
                            </thead>
                            <tbody>
                                {
                                    data.conferences.map((item) => (
                                        <tr class={item.featured ? "bg-accent/10" : ""}>
                                            <td class="font-bold">
                                                {item.title}
                                                {item.featured && (
                                                    <span class="badge badge-accent badge-xs ml-2">Featured</span>
                                                )}
                                            </td>
                                            <td>{item.year}</td>
                                            <td>{item.details}</td>
                                            <td>
                                                {item.link ? (
                                                    <a
                                                        href={item.link}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="btn btn-xs btn-primary"
                                                    >
                                                        View
                                                    </a>
                                                ) : (
                                                    <span class="badge badge-ghost">
                                                        -
                                                    </span>
                                                )}
                                            </td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[VOLUNTEERING]</span>
                        <span class="light-only">Volunteering</span>
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="table table-zebra font-mono text-sm">
                            <thead>
                                <tr><th>Activity</th><th>Year</th></tr>
                            </thead>
                            <tbody>
                                {
                                    data.volunteering.map((vol) => (
                                        <tr>
                                            <td class="font-bold">
                                                {vol.title}
                                            </td>
                                            <td>{vol.year}</td>
                                        </tr>
                                    ))
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card bg-base-200">
                <div class="card-body">
                    <h2 class="card-title text-primary">
                        <span class="dark-only font-mono">[GOALS]</span>
                        <span class="light-only">Goals</span>
                    </h2>
                    <ul class="list-disc list-inside">
                        {data.goals.map((goal) => <li>{goal}</li>)}
                    </ul>
                </div>
            </section>
        </div>
    </div>
</Layout>
